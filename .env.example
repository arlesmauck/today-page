# today-page configuration
#
# Everything user-facing — location, calendars, news feeds, curation — is
# edited live in the app's ⚙ settings panel (saved to data/settings.json).
# Those can still be seeded via env/compose as initial defaults, but this
# file only lists the env-only options below.

# ── Server & runtime ──────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8080
# DATA_DIR=/path/to/data
# REFRESH_INTERVAL=3600   # seconds between refresh cycles
# LOG_LEVEL=INFO

# ── AI summaries (optional) ───────────────────────────────────────────────────
# Needs AI_API_KEY (except Ollama). Without it the page falls back to RSS
# excerpts. AI_MODEL is a litellm string — the prefix routes the request:
#   openrouter/google/gemini-2.5-flash-lite   # cheap, fast (openrouter.ai/keys)
#   claude-haiku-4-5-20251001                 # Anthropic direct
#   gpt-4o-mini                               # OpenAI direct
#   ollama/llama3.2                           # local; AI_API_BASE for remote hosts
# AI_MODEL=openrouter/google/gemini-2.5-flash-lite
# AI_API_KEY=
# AI_API_BASE=

# ── Background context (optional) ─────────────────────────────────────────────
# Second model for the per-story "Background" primer. Perplexity sonar has
# built-in web search: openrouter/perplexity/sonar
# CONTEXT_MODEL=openrouter/perplexity/sonar
# CONTEXT_API_KEY=            # only if it differs from AI_API_KEY

# ── Google News supplementary feeds ───────────────────────────────────────────
# Broaden the curation pool; merge into matching category tabs. Stories use
# lede-based summaries (redirect URLs can't be fetched in full).
# NEWS_GNEWS_WORLD=true
# NEWS_GNEWS_TECH=true
# NEWS_GNEWS_SCI=true
# NEWS_GNEWS_HEALTH=true

# ── Tuning (rarely needed) ────────────────────────────────────────────────────
# MAX_ARTICLE_CHARS=8000        # article text sent to the summarizer
# MAX_BRIEFING_CANDIDATES=15    # stories considered for the morning briefing
